{
  "expo": {
    "name": "RebootApp",
    "slug": "RebootApp",
    "scheme": "reboot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash":{
      
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F8EF7"

},
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "이 앱이 사진에 접근할 수 있도록 허용해주세요.",
          "savePhotosPermission": "이 앱이 사진을 저장할 수 있도록 허용해주세요."
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dori20.rebootapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.anonymous.RebootApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8fc6a560-8738-4ea7-a3b8-983ab4a0985f"
      }
    }
  }
}
